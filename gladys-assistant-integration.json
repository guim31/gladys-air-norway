{
  "manifest_version": 1,
  "type": "device",
  "name": "Air quality Norway",
  "description": {
    "en": "Air quality forecast of MET Norway for your home or a station: index, pollutants, next 24 hours.",
    "fr": "Prévision de qualité de l'air de MET Norway chez vous ou à une station : indice, polluants, 24 h.",
    "de": "Luftqualitätsvorhersage von MET Norway für dein Zuhause oder eine Station: Index, Schadstoffe, 24 h.",
    "es": "Previsión de calidad del aire de MET Norway en su casa o una estación: índice, contaminantes, 24 h."
  },
  "version": "1.0.0",
  "docker_image": "ghcr.io/guim31/gladys-air-norway:1.0.0",
  "gladys_version": ">=5.2.0",
  "cover_image": "https://raw.githubusercontent.com/guim31/gladys-air-norway/main/cover.png",
  "categories": ["environment"],
  "transports": ["cloud"],
  "location": true,
  "config_schema": [
    {
      "key": "intro",
      "type": "section",
      "label": {
        "en": "Air quality forecast in Norway",
        "fr": "Prévision de la qualité de l'air en Norvège",
        "de": "Luftqualitätsvorhersage in Norwegen",
        "es": "Previsión de la calidad del aire en Noruega"
      },
      "description": {
        "en": "Reads the air quality forecast of MET Norway, the Norwegian Meteorological Institute, through its open API (no account). Each house of Gladys located in Norway becomes a device; stations can be added. Not affiliated with MET Norway.",
        "fr": "Lit la prévision de qualité de l'air de MET Norway, l'institut météorologique norvégien, par son API ouverte (sans compte). Chaque maison de Gladys située en Norvège devient un appareil ; on peut ajouter des stations. Non affilié à MET Norway.",
        "de": "Liest die Luftqualitätsvorhersage von MET Norway, dem norwegischen Meteorologischen Institut, über seine offene API (ohne Konto). Jedes Haus von Gladys mit Standort in Norwegen wird ein Gerät; Stationen können hinzukommen. Nicht mit MET Norway verbunden.",
        "es": "Lee la previsión de calidad del aire de MET Norway, el Instituto Meteorológico de Noruega, mediante su API abierta (sin cuenta). Cada casa de Gladys ubicada en Noruega se convierte en un dispositivo; puede añadir estaciones. Sin afiliación con MET Norway."
      },
      "links": [
        {
          "url": "https://luftkvalitet.miljodirektoratet.no/kart",
          "label": {
            "en": "Air quality map (luftkvalitet.info)",
            "fr": "Carte de la qualité de l'air (luftkvalitet.info)",
            "de": "Luftqualitätskarte (luftkvalitet.info)",
            "es": "Mapa de la calidad del aire (luftkvalitet.info)"
          }
        },
        {
          "url": "https://api.met.no/weatherapi/airqualityforecast/0.1/documentation",
          "label": {
            "en": "The MET Norway API",
            "fr": "L'API de MET Norway",
            "de": "Die API von MET Norway",
            "es": "La API de MET Norway"
          }
        }
      ]
    },
    {
      "key": "area_level",
      "type": "select",
      "label": {
        "en": "Area around a house",
        "fr": "Zone autour d'une maison",
        "de": "Gebiet um ein Haus",
        "es": "Zona alrededor de una casa"
      },
      "description": {
        "en": "The forecast of a house is the one of the area it lies in. Changing it reads the houses again.",
        "fr": "La prévision d'une maison est celle de la zone où elle se trouve. Changer ce choix relit les maisons.",
        "de": "Die Vorhersage eines Hauses ist die des Gebiets, in dem es liegt. Eine Änderung liest die Häuser neu.",
        "es": "La previsión de una casa es la de la zona donde se encuentra. Cambiar esta opción vuelve a leer las casas."
      },
      "required": false,
      "default": "grunnkrets",
      "options": [
        {
          "value": "grunnkrets",
          "label": {
            "en": "Neighbourhood (grunnkrets)",
            "fr": "Quartier (grunnkrets)",
            "de": "Viertel (grunnkrets)",
            "es": "Barrio (grunnkrets)"
          }
        },
        {
          "value": "delomrade",
          "label": {
            "en": "District (delområde)",
            "fr": "Secteur (delområde)",
            "de": "Bezirk (delområde)",
            "es": "Distrito (delområde)"
          }
        },
        {
          "value": "kommune",
          "label": {
            "en": "Municipality (kommune)",
            "fr": "Commune (kommune)",
            "de": "Gemeinde (kommune)",
            "es": "Municipio (kommune)"
          }
        }
      ]
    },
    {
      "key": "stations",
      "type": "string",
      "label": {
        "en": "Stations",
        "fr": "Stations",
        "de": "Stationen",
        "es": "Estaciones"
      },
      "description": {
        "en": "Optional: the codes of measuring stations to follow too, separated by commas (10 at most). The \"Find a station\" button below gives them.",
        "fr": "Facultatif : les codes des stations de mesure à suivre en plus, séparés par des virgules (10 au plus). Le bouton « Trouver une station » ci-dessous les donne.",
        "de": "Optional: die Codes zusätzlicher Messstationen, durch Kommas getrennt (höchstens 10). Der Button „Station finden“ unten liefert sie.",
        "es": "Opcional: los códigos de las estaciones de medición que también desea seguir, separados por comas (10 como máximo). El botón «Buscar una estación» más abajo se los da."
      },
      "placeholder": {
        "en": "e.g. NO0057A, NO0101A",
        "fr": "ex. NO0057A, NO0101A",
        "de": "z. B. NO0057A, NO0101A",
        "es": "p. ej. NO0057A, NO0101A"
      },
      "required": false,
      "default": ""
    },
    {
      "key": "language",
      "type": "select",
      "label": {
        "en": "Language",
        "fr": "Langue",
        "de": "Sprache",
        "es": "Idioma"
      },
      "description": {
        "en": "Language of the feature names (set when a device is added) and of the scene texts.",
        "fr": "Langue des noms de fonctionnalités (fixés à l'ajout d'un appareil) et des textes de scène.",
        "de": "Sprache der Funktionsnamen (beim Hinzufügen eines Geräts festgelegt) und der Szenentexte.",
        "es": "Idioma de los nombres de las funciones (fijados al añadir un dispositivo) y de los textos de escena."
      },
      "required": false,
      "default": "fr",
      "options": [
        {
          "value": "en",
          "label": {
            "en": "English",
            "fr": "Anglais",
            "de": "Englisch",
            "es": "Inglés"
          }
        },
        {
          "value": "fr",
          "label": {
            "en": "French",
            "fr": "Français",
            "de": "Französisch",
            "es": "Francés"
          }
        },
        {
          "value": "de",
          "label": {
            "en": "German",
            "fr": "Allemand",
            "de": "Deutsch",
            "es": "Alemán"
          }
        },
        {
          "value": "es",
          "label": {
            "en": "Spanish",
            "fr": "Espagnol",
            "de": "Spanisch",
            "es": "Español"
          }
        }
      ]
    }
  ],
  "actions": [
    {
      "key": "find_station",
      "label": {
        "en": "Find a station",
        "fr": "Trouver une station",
        "de": "Station finden",
        "es": "Buscar una estación"
      },
      "timeout_seconds": 30,
      "fields": [
        {
          "key": "query",
          "type": "string",
          "label": {
            "en": "Name or municipality",
            "fr": "Nom ou commune",
            "de": "Name oder Gemeinde",
            "es": "Nombre o municipio"
          },
          "description": {
            "en": "Accents and ø, æ, å are optional. Empty: the stations nearest to the house.",
            "fr": "Accents et ø, æ, å facultatifs. Vide : les stations les plus proches de la maison.",
            "de": "Akzente und ø, æ, å sind optional. Leer: die Stationen, die dem Haus am nächsten sind.",
            "es": "Los acentos y ø, æ, å son opcionales. Vacío: las estaciones más cercanas a la casa."
          },
          "placeholder": {
            "en": "e.g. Bergen",
            "fr": "ex. Bergen",
            "de": "z. B. Bergen",
            "es": "p. ej. Bergen"
          },
          "required": false
        },
        {
          "key": "house",
          "type": "select",
          "source": "houses",
          "label": {
            "en": "House",
            "fr": "Maison",
            "de": "Haus",
            "es": "Casa"
          },
          "description": {
            "en": "Sorts by distance. Empty: the first located house when no name is typed.",
            "fr": "Trie par distance. Vide : la première maison située si aucun nom n'est saisi.",
            "de": "Sortiert nach Entfernung. Leer: das erste Haus mit Standort, wenn kein Name eingegeben ist.",
            "es": "Ordena por distancia. Vacío: la primera casa con ubicación si no escribe ningún nombre."
          },
          "required": false
        }
      ]
    },
    {
      "key": "check_places",
      "label": {
        "en": "Check the places",
        "fr": "Vérifier les lieux",
        "de": "Orte prüfen",
        "es": "Comprobar los lugares"
      },
      "timeout_seconds": 120
    }
  ],
